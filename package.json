{
  "name": "m-agent",
  "version": "0.6.0",
  "private": true,
  "description": "Game music MIDI editor with a permission-aware desktop agent.",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 file:dist-electron/main/index.js file:dist-electron/preload/index.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "clean:electron": "node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "build:electron": "npm run clean:electron && tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "start": "electron .",
    "test": "vitest run",
    "test:electron": "npm run build && node scripts/electron-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:icon:win": "node scripts/build-windows-icon.mjs",
    "package:win": "npm run build:icon:win && npm run build && electron-builder --win nsis --config.electronDist=node_modules/electron/dist",
    "package:mac": "npm run build && electron-builder --mac dmg zip",
    "package:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@tonejs/midi": "^2.0.28",
    "electron-store": "^10.0.1",
    "nanoid": "^5.1.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "spessasynth_core": "^4.3.17",
    "spessasynth_lib": "^4.3.13",
    "wasm-media-encoders": "^0.7.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "43.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "studio.magent.desktop",
    "productName": "M Agent",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "extraResources": [
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "agent",
        "to": "agent"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "extraResources": [
        {
          "from": "build/icon.ico",
          "to": "icons/icon.ico"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.icns",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icons",
      "category": "AudioVideo",
      "executableName": "m-agent",
      "extraResources": [
        {
          "from": "build/icons/512x512.png",
          "to": "icons/icon.png"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
